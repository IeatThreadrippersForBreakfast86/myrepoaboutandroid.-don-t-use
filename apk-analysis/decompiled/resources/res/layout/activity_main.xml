<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?android:attr/colorBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/hero_gradient"
            android:paddingLeft="@dimen/hero_padding"
            android:paddingTop="@dimen/hero_padding"
            android:paddingRight="@dimen/hero_padding"
            android:paddingBottom="@dimen/hero_padding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/hero_padding">
            <com.google.android.material.textview.MaterialTextView
                android:textAppearance="?attr/textAppearanceHeadlineMedium"
                android:textSize="@dimen/hero_title_size"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/title"
                android:letterSpacing="0.01"/>
            <com.google.android.material.textview.MaterialTextView
                android:textSize="@dimen/hero_subtitle_size"
                android:textColor="#e0ffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:text="@string/subtitle"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:paddingLeft="@dimen/screen_padding_horizontal"
            android:paddingTop="@dimen/content_spacing_large"
            android:paddingRight="@dimen/screen_padding_horizontal"
            android:paddingBottom="@dimen/screen_padding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/screen_padding_horizontal">
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardConfig"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/content_spacing"
                style="@style/Widget.LANBridge.CardView">
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.google.android.material.textview.MaterialTextView
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textStyle="bold"
                        android:textColor="?attr/colorPrimary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/content_spacing"
                        android:text="@string/section_config"/>
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilRemoteHost"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_remote_host"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etRemoteHost"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:inputType="textUri"
                            android:imeOptions="actionNext"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilRemotePort"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/content_spacing"
                        android:hint="@string/label_remote_port"
                        app:helperText="@string/helper_remote_port"
                        app:helperTextEnabled="true"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etRemotePort"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:maxLength="5"
                            android:inputType="number"
                            android:imeOptions="actionNext"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilLocalPort"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/content_spacing"
                        android:hint="@string/label_local_port"
                        app:helperText="@string/helper_local_port"
                        app:helperTextEnabled="true"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etLocalPort"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:maxLength="5"
                            android:inputType="number"
                            android:imeOptions="actionNext"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAdvanced"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/content_spacing"
                style="@style/Widget.LANBridge.CardView">
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.google.android.material.textview.MaterialTextView
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textStyle="bold"
                        android:textColor="?attr/colorSecondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/content_spacing"
                        android:text="@string/section_advanced"/>
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilProxyPort"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/label_proxy_port"
                        app:helperText="@string/helper_proxy_port"
                        app:helperTextEnabled="true"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etProxyPort"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:maxLength="5"
                            android:inputType="number"
                            android:imeOptions="actionNext"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilUdpRelayPort"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/content_spacing"
                        android:hint="@string/label_udp_relay_port"
                        app:helperText="@string/helper_udp_relay_port"
                        app:helperTextEnabled="true"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etUdpRelayPort"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:maxLength="5"
                            android:inputType="number"
                            android:imeOptions="actionDone"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/content_spacing"
                android:text="@string/btn_test"
                style="@style/Widget.LANBridge.Button.Tonal"/>
            <com.google.android.material.button.MaterialButton
                android:textColor="@android:color/white"
                android:id="@+id/btnStart"
                android:background="@drawable/btn_start_gradient"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/btn_start"
                app:backgroundTint="@null"
                app:icon="@drawable/ic_bridge"
                app:iconTint="@android:color/white"
                style="@style/Widget.LANBridge.Button.Primary"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStop"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="@dimen/content_spacing"
                android:text="@string/btn_stop"
                style="@style/Widget.LANBridge.Button.Outlined"/>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/content_spacing_large"
                android:layout_marginBottom="@dimen/content_spacing"
                style="@style/Widget.LANBridge.CardView">
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <View
                            android:id="@+id/statusDot"
                            android:background="@drawable/status_dot"
                            android:layout_width="@dimen/status_dot_glow_size"
                            android:layout_height="@dimen/status_dot_glow_size"
                            android:layout_marginEnd="10dp"/>
                        <com.google.android.material.textview.MaterialTextView
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textStyle="bold"
                            android:id="@+id/tvStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/state_stopped"/>
                    </LinearLayout>
                    <View
                        android:background="?attr/colorSurfaceVariant"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/content_spacing"
                        android:layout_marginBottom="@dimen/content_spacing"
                        android:alpha="0.6"
                        android:layout_marginVertical="@dimen/content_spacing"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp">
                        <com.google.android.material.textview.MaterialTextView
                            android:textSize="13sp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/label_remote"
                            android:layout_weight="1"/>
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/tvRemote"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:layout_weight="2"
                            android:textIsSelectable="true"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp">
                        <com.google.android.material.textview.MaterialTextView
                            android:textSize="13sp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/label_local"
                            android:layout_weight="1"/>
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/tvLocal"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:layout_weight="2"
                            android:textIsSelectable="true"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp">
                        <com.google.android.material.textview.MaterialTextView
                            android:textSize="13sp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/label_proxy"
                            android:layout_weight="1"/>
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/tvProxy"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:layout_weight="2"
                            android:textIsSelectable="true"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp">
                        <com.google.android.material.textview.MaterialTextView
                            android:textSize="13sp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/label_udp"
                            android:layout_weight="1"/>
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/tvUdp"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:layout_weight="2"
                            android:textIsSelectable="true"/>
                    </LinearLayout>
                    <View
                        android:background="?attr/colorSurfaceVariant"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="6dp"
                        android:alpha="0.4"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp">
                        <com.google.android.material.textview.MaterialTextView
                            android:textSize="13sp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/label_connections"
                            android:layout_weight="1"/>
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/tvConnections"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:layout_weight="2"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <com.google.android.material.textview.MaterialTextView
                            android:textSize="13sp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/label_mappings"
                            android:layout_weight="1"/>
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/tvMappings"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:layout_weight="2"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.LANBridge.CardView">
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.google.android.material.textview.MaterialTextView
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="?attr/colorTertiary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/label_log"/>
                    <ScrollView
                        android:id="@+id/logScroll"
                        android:background="?attr/colorSurfaceVariant"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/log_height"
                        android:fillViewport="true"
                        android:alpha="0.4">
                        <com.google.android.material.textview.MaterialTextView
                            android:textSize="@dimen/log_text_size"
                            android:id="@+id/tvLog"
                            android:padding="10dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textIsSelectable="true"
                            android:fontFamily="monospace"/>
                    </ScrollView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
